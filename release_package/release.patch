+real(double) function step_head(zz,ll,dt,dd) result(h)
+  real(double),intent(in)::zz,ll,dt,dd
+  real(double)::root,aa,bb,ss,term,nn
+  integer::kk
+  h=0.d0
+  if(dt<=0.d0) return
+  if(dd*dt/(ll*ll)>1.d0) then
+    ss=0.d0
+    do kk=1,mmax
+      nn=dble(kk)
+      term=cos(nn*pi*zz/ll)*exp(-dd*dt*(nn*pi/ll)**2)/(nn*nn)
+      ss=ss+term
+      if(abs(term)<1.d-14) exit
+    enddo
+    h=dd*dt/ll+(ll-zz)**2/(2.d0*ll)-ll/6.d0-2.d0*ll*ss/(pi*pi)
+  else
+    root=sqrt(dd*dt)
+    ss=0.d0
+    do kk=1,mmax
+      nn=dble(kk)
+      aa=((2.d0*nn-1.d0)*ll-(ll-zz))/(2.d0*root)
+      bb=((2.d0*nn-1.d0)*ll+(ll-zz))/(2.d0*root)
+      term=exp(-aa*aa)/sqrt(pi)-aa*derfc(aa)+exp(-bb*bb)/sqrt(pi)-bb*derfc(bb)
+      ss=ss+term
+      if(abs(term)<1.d-14) exit
+    enddo
+    h=2.d0*root*ss
+  endif
+end function step_head
